# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Planilha de controle (aba "Vagas": cabeçalho na linha 4, vaga nº 1 na linha 5).
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/ID_DA_PLANILHA/edit

# Google Doc com o currículo base (única fonte da verdade do gerador de currículo).
GOOGLE_DOC_CV_BASE_URL=https://docs.google.com/document/d/ID_DO_DOC/edit

# Arquivo JSON da Service Account (pasta secrets/ é ignorada pelo Git).
# Compartilhe a planilha e o Doc com o e-mail "client_email" desse arquivo.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json

# O pipeline NÃO usa LLM: Perfil e currículo sob medida são gerados por regras determinísticas (custo zero, sem chave de API).

# false (padrão): preenche, mas não envia. true: envia e guarda o comprovante em output/receipts/.
# --dry-run sempre vence: com ele nada é enviado e nada é escrito na planilha.
AUTO_SUBMIT=false

# Opcionais
# OUTPUT_DIR=output
# BROWSER_USER_DATA_DIR=output/sessao-navegador
# Candidatura: a janela do navegador aparece (a aba com Pendência fica aberta para você terminar). true esconde a janela.
# APPLY_HEADLESS=false

# Dados que portais pedem e o currículo não tem (CPF, nascimento, gênero, disponibilidade...).
# Copie dados-complementares.example.json para este caminho e preencha. Nunca vai ao LLM nem ao Git.
DADOS_COMPLEMENTARES_FILE=secrets/dados-complementares.json

# Radar de Vagas
# Fontes, na ordem de busca (padrão: todas). O Indeed costuma bloquear acesso automatizado; o Radar só relata e segue.
# RADAR_FONTES=gupy,solides,infojobs,linkedin,indeed,github
# Idade máxima (em dias) da publicação de uma vaga.
# RADAR_VIGENCIA_DIAS=20
# Máximo de vagas aprovadas por execução (a Cota DF de 50% vale sobre este lote).
# MAX_VAGAS_LOTE=10
# Repositórios de vagas do GitHub (issues), separados por vírgula.
# RADAR_REPOS_GITHUB=frontendbr/vagas,backend-br/vagas
# Opcional: token do GitHub só para aumentar o limite de requisições da API pública. Sem permissões especiais.
# GITHUB_TOKEN=
# Provisório até o Perfil ser extraído do currículo: habilidades que pontuam a vaga, separadas por vírgula.
# RADAR_STACK=
